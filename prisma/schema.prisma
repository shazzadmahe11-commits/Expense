// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Card {
  id           String        @id @default(cuid())
  userId       String
  name         String
  type         String        // "CREDIT" | "DEBIT"
  color        String        @default("#6366f1")
  limit        Float?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
}

model Category {
  id           String        @id @default(cuid())
  userId       String
  name         String
  icon         String        @default("💰")
  color        String        @default("#6366f1")
  transactions Transaction[]
  budget       Budget?
  createdAt    DateTime      @default(now())

  @@unique([userId, name])
  @@index([userId])
}

// One recurring monthly limit per category (applies to every month, not tied to a specific one).
model Budget {
  id         String   @id @default(cuid())
  userId     String
  categoryId String   @unique
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount     Float
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Float
  type        String   // "EXPENSE" | "INCOME" | "TRANSFER"
  description String?
  date        DateTime
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  transferId  String?  // links the two legs of a card-to-card transfer
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([transferId])
}

// Fully standalone — not linked to Card, Category, or Transaction in any way.
model Investment {
  id        String   @id @default(cuid())
  userId    String
  broker    String
  stock     String
  amount    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
